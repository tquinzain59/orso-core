# Image Python slim de base pour Orso Agents Core
FROM python:3.11-slim

LABEL maintainer="Thibaut - Orso Agents (www.orso-agents.fr)"
LABEL version="1.0-orso-core"

# Empêche Python d'écrire des fichiers .pyc et configure le tampon de sortie pour Docker
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH="/app"
ENV HERMES_HOME="/app/data/hermes_home"

# Installation des dépendances système de base, de ripgrep et de gosu
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    build-essential \
    ripgrep \
    gosu \
    && rm -rf /var/lib/apt/lists/*

# Intégration de Node.js 22 LTS officiel pour satisfaire les contraintes engines du projet (Node >= 22, npm >= 10)
COPY --from=node:22-bookworm-slim /usr/local/bin/node /usr/local/bin/node
COPY --from=node:22-bookworm-slim /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -sf /usr/local/bin/node /usr/local/bin/nodejs && \
    ln -sf ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && \
    ln -sf ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

# Installation de 'uv' pour accélérer l'installation des dépendances Python
RUN pip install --no-cache-dir uv

WORKDIR /app

# Création d'un utilisateur non-root 'orso' pour des raisons de sécurité
RUN groupadd -g 10001 orso && \
    useradd -u 10001 -g orso -m -d /home/orso orso

# Création préalable des répertoires de configuration et de travail
RUN mkdir -p /home/orso/.hermes /app/config /app/skills /app/data/hermes_home /app/data/agents /app/data/reports /app/data/telemetry /app/profiles /app/templates && \
    chown -R orso:orso /home/orso /app

# Copie préalable des dépendances pour le cache Docker
COPY requirements-base.txt /app/

# Copie du code source complet du moteur Orso
COPY . /app/

# Installation du moteur Orso en mode éditable local + dépendances métier
RUN uv pip install --system --no-cache-dir -e /app -r /app/requirements-base.txt

# S'assure que les dossiers du dashboard, du TUI précompilé et de l'UI Client existent avec les bons droits
RUN mkdir -p /app/apps/ui-client/dist /app/hermes_cli/web_dist /app/hermes_cli/tui_dist && \
    chown -R orso:orso /app/apps/ui-client /app/hermes_cli/web_dist /app/hermes_cli/tui_dist

# Configuration par défaut
RUN if [ ! -f /app/config/hermes.yaml ] && [ -f /app/config/hermes.default.yaml ]; then \
        cp /app/config/hermes.default.yaml /app/config/hermes.yaml; \
    fi

# Liaisons symboliques pour que l'agent accède à la config et aux skills
RUN ln -sf /app/config/hermes.yaml /home/orso/.hermes/config.yaml && \
    ln -sf /app/skills /home/orso/.hermes/skills && \
    chown -h orso:orso /home/orso/.hermes/config.yaml /home/orso/.hermes/skills && \
    chown -R orso:orso /app /home/orso

# Droits d'exécution sur le script d'entrypoint
RUN chmod +x /app/docker/orso-entrypoint.sh

# Port exposé par le serveur de dashboard / API
EXPOSE 9119

# Entrypoint garantissant permissions, persistance et drop de privilèges vers 'orso' (UID 10001)
ENTRYPOINT ["/app/docker/orso-entrypoint.sh"]

# Commande de démarrage par défaut : dashboard officiel Hermès avec session auth et WebSockets
CMD ["hermes", "dashboard", "--host", "0.0.0.0", "--port", "9119", "--no-open", "--skip-build"]
