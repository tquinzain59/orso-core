# ==============================================================================
# Orso Agents - Modèle d'Environnement de Déploiement Client (.env)
# ==============================================================================
# Copiez ce fichier vers .env à la racine de votre projet et renseignez les valeurs :
#   cp orso.env.example .env

# ── 1. Paramètres du Conteneur Docker & Isolation ─────────────────────────────
# Nom unique des conteneurs pour cette instance client
ORSO_CLIENT_CONTAINER=orso_client_backend
ORSO_UI_CONTAINER=orso_client_ui

# Identifiant UUID et slug de l'organisation dans la base Supabase
# Exemples :
#   ORSO_CLIENT_ID=f3e25379-6531-479e-b276-3b3185e7421b
#   ORSO_CLIENT_SLUG=financia-solutions
ORSO_CLIENT_ID=
ORSO_CLIENT_SLUG=

# ── 2. Authentification IAM Supabase ──────────────────────────────────────────
# URL de l'instance Supabase (Cloud ou On-Premise)
SUPABASE_URL=https://your-project.supabase.co
# Clé de rôle de service (pour l'authentification côté backend)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_service_role_key

# ── 3. Fournisseurs de Modèles de Langage (LLM) ───────────────────────────────
# Clé OpenRouter (modèle principal : deepseek/deepseek-v4-flash)
OPENROUTER_API_KEY=sk-or-v1-...

# Clés optionnelles (failover ou moteurs spécifiques)
GOOGLE_API_KEY=
OPENAI_API_KEY=
AIRTABLE_API_KEY=

# ── 4. Dashboard d'Administration de Secours (Accès direct /admin) ─────────────
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
# Mot de passe en clair (haché automatiquement en mémoire par Hermès)
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=admin
# Ou hash scrypt précalculé (optionnel, avec simples $ si renseigné dans .env) :
# HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=scrypt$16384$8$1$ISSlbORw91Gyari7jv6+lA==$W0h3DLb/8dG9sAjcfTtPlm3shTjg8um+PMTDz/3Glvo=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=

# ── 5. Persistance et Chemins Internes ────────────────────────────────────────
HERMES_CONFIG_PATH=/app/config/hermes.yaml
HERMES_HOME=/app/data/hermes_home
